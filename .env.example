# Supabase (ver SPEC.md 6.1). Obtener de Project Settings > API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponer al cliente. Solo usar en API routes / server actions (bypassea RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Cron: token compartido para autorizar la llamada a /api/cron/expirar-reservas
# (ver app/api/cron/expirar-reservas/route.ts). Generar con `openssl rand -hex 32`.
CRON_SECRET=
